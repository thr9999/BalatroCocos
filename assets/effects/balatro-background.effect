CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        bgResolution: { value: [1920, 1080], target: u_bgResolution.xy }
        bgTime: { value: 0.0, target: u_bgParams.x }
        bgSpinTime: { value: 0.0, target: u_bgParams.y }
        bgContrast: { value: 1.0, target: u_bgParams.z }
        bgSpinAmount: { value: 0.0, target: u_bgParams.w }
        bgColour1: { value: [0.2824, 0.4659, 0.3882, 1.0], target: u_bgColour1 }
        bgColour2: { value: [0.4078, 0.6729, 0.5608, 1.0], target: u_bgColour2 }
        bgColour3: { value: [0.2196, 0.3624, 0.3020, 1.0], target: u_bgColour3 }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;

  in vec4 color;
  in vec2 uv0;

  uniform BalatroBackground {
    vec4 u_bgResolution;
    vec4 u_bgParams;
    vec4 u_bgColour1;
    vec4 u_bgColour2;
    vec4 u_bgColour3;
  };

  #define PIXEL_SIZE_FAC 700.0
  #define SPIN_EASE 0.5

  vec4 frag () {
    vec2 resolution = max(u_bgResolution.xy, vec2(1.0));
    float bg_time = u_bgParams.x;
    float spin_time = u_bgParams.y;
    float contrast = max(u_bgParams.z, 0.001);
    float spin_amount = u_bgParams.w;

    float pixel_size = length(resolution.xy) / PIXEL_SIZE_FAC;
    vec2 screen_coords = gl_FragCoord.xy;
    vec2 uv = (floor(screen_coords.xy * (1.0 / pixel_size)) * pixel_size - 0.5 * resolution.xy) / length(resolution.xy) - vec2(0.12, 0.0);
    float uv_len = length(uv);

    float speed = (spin_time * SPIN_EASE * 0.2) + 302.2;
    float new_pixel_angle = atan(uv.y, uv.x) + speed - SPIN_EASE * 20.0 * (spin_amount * uv_len + (1.0 - spin_amount));
    vec2 mid = (resolution.xy / length(resolution.xy)) / 2.0;
    uv = vec2(uv_len * cos(new_pixel_angle) + mid.x, uv_len * sin(new_pixel_angle) + mid.y) - mid;

    uv *= 30.0;
    speed = bg_time * 2.0;
    vec2 uv2 = vec2(uv.x + uv.y);

    for (int i = 0; i < 5; i++) {
      uv2 += sin(max(uv.x, uv.y)) + uv;
      uv += 0.5 * vec2(
        cos(5.1123314 + 0.353 * uv2.y + speed * 0.131121),
        sin(uv2.x - 0.113 * speed)
      );
      uv -= 1.0 * cos(uv.x + uv.y) - 1.0 * sin(uv.x * 0.711 - uv.y);
    }

    float contrast_mod = 0.25 * contrast + 0.5 * spin_amount + 1.2;
    float paint_res = min(2.0, max(0.0, length(uv) * 0.035 * contrast_mod));
    float c1p = max(0.0, 1.0 - contrast_mod * abs(1.0 - paint_res));
    float c2p = max(0.0, 1.0 - contrast_mod * abs(paint_res));
    float c3p = 1.0 - min(1.0, c1p + c2p);

    vec4 colour_1 = u_bgColour1;
    vec4 colour_2 = u_bgColour2;
    vec4 colour_3 = u_bgColour3;
    vec4 ret_col = (0.3 / contrast) * colour_1
      + (1.0 - 0.3 / contrast) * (colour_1 * c1p + colour_2 * c2p + vec4(c3p * colour_3.rgb, c3p * colour_1.a));

    ret_col.a *= color.a;
    return ret_col;
  }
}%
